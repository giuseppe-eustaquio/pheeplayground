      "id": "8c92ec38-f80d-426d-9b42-b1de335a85d7",
      "name": "Groq Chat Model"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this ticket content:\nTicket subject: {{ $json.subject }}\nTicket content: {{ $json.description }}\n\nCurrent weather data:\nCountry code: {{ $json.country }}\nWeather: {{ $json.weather }}\nWeather description: {{ $json.weather_description }}\nTemperature: {{ $json.temperature }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a professional meteorologist and ticket analyzer. Your first task is to analyze the ticket message that will come in. Next, analyze the current weather. Finally, create an internal note to see if the issue could be related to the current weather or note. Make your final output just plain text (no markdown), but add paragraphs/extra lines to make it readable as a final Zendesk internal note"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1072,
        32
      ],
      "id": "127e248e-acfb-470d-b7e9-a614f41496db",
      "name": "Analyze Weather and Output Internal Note"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  let text = item.json.text;\n\n  // Strip markdown formatting\n  text = text\n    .replace(/\\*\\*(.*?)\\*\\*/g, '$1')     // bold\n    .replace(/^#+\\s*/gm, '')              // headers\n    .replace(/^>\\s?/gm, '')               // blockquotes\n    .replace(/^-\\s+/gm, '• ')             // bullet points → simple dash/bullet\n    .replace(/\\n{3,}/g, '\\n\\n');          // collapse extra blank lines\n\n  results.push({\n    json: {\n      note: text.trim()\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        32
      ],
      "id": "d1fd9f85-c571-4152-93d5-5ee03d189da9",
      "name": "Remove markdown"
    },
    {
      "parameters": {
        "operation": "update",
        "id": "={{ $('Merge Ticket and Weather Data').item.json.id }}",
        "updateFields": {
          "internalNote": "={{ $json.note }}"
        }
