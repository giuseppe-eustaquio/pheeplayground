    {
      "parameters": {
        "jsCode": "const aggregatedData = $('Aggregate All Locations').first().json.data;\nconst aiAnalysis = $input.first().json.text || 'Analysis unavailable';\n\nlet report = `🌍 **WEATHER INTELLIGENCE REPORT**\\n`;\nreport += `━━━━━━━━━━━━━━━━━━━━━━━\\n\\n`;\n\nfor (const loc of aggregatedData) {\n  report += `📍 **${loc.city}**\\n`;\n  report += `├ 🌡️ ${loc.current.temperature}°C (Comfort: ${loc.analysis.comfortIndex}/100)\\n`;\n  report += `├ 🫁 AQI: ${loc.airQuality.label}\\n`;\n  if (loc.analysis.alerts.length > 0) report += `├ ⚠️ ALERT: ${loc.analysis.alerts.join(', ')}\\n`;\n  report += `\\n`;\n}\n\nreport += `🤖 **AI ANALYSIS**\\n${aiAnalysis}`;\n\nreturn [{\n  json: {\n    report: report,\n    hasAlerts: aggregatedData.some(loc => loc.analysis.hasAlerts)\n  }\n}];"
      },
